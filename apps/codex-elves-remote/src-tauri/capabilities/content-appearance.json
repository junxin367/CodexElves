{
  "identifier": "content-appearance",
  "description": "远程内容可同步配色与未读角标、管理公开网页缓存及打开同来源的会话/文件预览窗口，原生逐次复核来源。",
  "local": true,
  "remote": {"urls": ["http://*:*/*", "https://*:*/*"]},
  "webviews": ["remote-content", "remote-content-session-*"],
  "permissions": ["remote-appearance", "remote-resource-cache", "remote-session-window", "remote-taskbar-badge"]
}
