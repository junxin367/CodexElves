{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexElves Remote",
  "version": "0.7.0",
  "identifier": "com.codexelves.remote",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["connection-page", "titlebar", "content-appearance"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../codex-elves-manager/src-tauri/icons/icon.ico"]
  }
}
